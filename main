
from menu import get_menu_item
from cart import Cart
from checkout import validate_name, validate_contact_number
from orders import create_order, save_order, display_confirmation


# 1. Create a cart and add food items
cart = Cart()

cart.add_item(get_menu_item(1), 2)  # 2 Classic Burgers
cart.add_item(get_menu_item(5), 1)  # 1 French Fries

# 2. Create customer information
customer = {
    "customer_name": "Alex Smith",
    "contact_number": "555-123-4567"
}

# 3. Validate customer information
assert validate_name(customer["customer_name"])
assert validate_contact_number(customer["contact_number"])

# 4. Create and save the order
order = create_order(cart, customer)
save_order(order)

# 5. Display the confirmation
display_confirmation(order)

print("\nOrder saved successfully to orders.json!")
